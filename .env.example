APP_NAME=فرابهداشت
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farabehdasht
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@farabehdasht.ir"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ماژول Identity — پیامک
#
# درایور پیامک: log · melipayamak · melipayamak_pattern
#
#   log                  پیام در storage/logs/laravel.log می‌نشیند. فقط توسعه و آزمایش.
#   melipayamak          متن آزاد از خط عمومی. به گوشی‌های مسدودکننده تبلیغات نمی‌رسد،
#                        پس برای رمز ورود مناسب نیست.
#   melipayamak_pattern  خط خدماتی با الگو. انتخاب درست برای رمز یک‌بارمصرف.
FBH_SMS_DRIVER=log

# مشترک بین هر دو درایور ملی‌پیامک
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=

# فقط برای درایور melipayamak — شماره خط عمومی فرستنده
MELIPAYAMAK_FROM=

# فقط برای درایور melipayamak_pattern — شناسه الگوی تأییدشده در پنل.
# الگوی ورود باید دقیقاً یک متغیر داشته باشد: خود کد.
#   نمونه متن الگو:  کد ورود شما به فرابهداشت: {0}
MELIPAYAMAK_PATTERN_OTP=

# الگوی پیامک اعلان (DEC-39) با دو متغیر: عنوان خبر و پیوند آن.
#   نمونه متن الگو:  فرابهداشت: {0}
#                    {1}
MELIPAYAMAK_PATTERN_NOTICE=

# پیامک اعلان‌های مهم (نتیجه بررسی، واریز، پایان Pro، کالیبراسیون).
# پس از تأیید الگوی بالا در پنل ملی‌پیامک روشن کنید. روزی ۳ پیامک، سکوت ۲۲ تا ۸.
FBH_SMS_NOTICES=false
