{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "farabehdasht/calc-engine",
    "description": "موتور محاسبات بهداشت حرفه‌ای — PHP خالص، بدون وابستگی به فریم‌ورک",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Farabehdasht\\CalcEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farabehdasht\\CalcEngine\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
